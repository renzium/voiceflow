{
  "name": "voiceflow",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:emulator": "expo run:android",
    "ios": "expo run:ios",
    "ios:simulator": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test": "tsx --test src/**/*.test.ts && npm --prefix server test",
    "server": "npm --prefix server run dev"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.11"
  }
}
